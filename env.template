# HRMS Environment Variables
#
# Copy to `.env` and fill in. Never commit the filled file.
# NOTE: lib/auth.ts error text says ".env.local", but this repo reads `.env`.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/hrms

# ---------------------------------------------------------------------------
# Auth (REQUIRED)
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 32
JWT_SECRET=change-this-in-production

# Access token lifetime. Short by design — the Session record is the real
# source of truth and can be revoked server-side.
JWT_EXPIRES_IN=1h

# Server-side session lifetime, in days.
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Field-level encryption (REQUIRED)
# ---------------------------------------------------------------------------
# Encrypts Aadhaar, PAN, and bank account numbers at rest (AES-256-GCM).
# Must be exactly 64 hex characters (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠ Losing or rotating this key makes existing encrypted values unreadable.
#   Back it up somewhere durable before storing real employee data.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Platform Super Admin (REQUIRED for `npm run seed:super-admin`)
# ---------------------------------------------------------------------------
# Exactly one super admin exists. It has no organization membership and can
# read every tenant's data — use a strong, unique password (min 12 chars) and
# enable 2FA before go-live.
SUPER_ADMIN_EMAIL=deepakvarshney.com@gmail.com
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Shared secret for /api/cron/daily (document expiries, probation endings,
# contract expiries, birthday and anniversary notifications). The cron caller
# sends it as: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# ---------------------------------------------------------------------------
# File storage — Cloudinary (planned)
# ---------------------------------------------------------------------------
# HR documents (Aadhaar, PAN, offer letters) MUST be uploaded with
# type: "authenticated" and served via short-lived signed URLs. Only profile
# photos may be public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email — Resend (planned)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
